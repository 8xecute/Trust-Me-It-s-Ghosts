  "ritualReleaseContract": {
    "steps": [
      "inspect bracelet and thread network",
      "protect hostages and participants; mitigate line pull or detach safe strands where feasible",
      "release controlled binding at bracelet without random yanking",
      "resolve action with existing Core/Combat; verify no active binding"
    ],
    "permittedAlternatives": "player approaches that achieve same physical/ritual goals using established tools/abilities are eligible; DM adjudicates with existing rules",
    "successCondition": "actual action resolved and single ritual binding stops; then set all residual tethers false",
    "failForward": "unknown/basic plan can inspect more, protect, retry meaningfully different approach; no invented DC",
    "noInventedStats": true
  },
  "endingAAdditionalGuards": [
    "RITUAL_STATUS=stopped",
    "HOSTAGES_SAFE=3",
    "HOSTAGES_DEAD=0",
    "PLAYER_DEATHS=0",
    "WICHAI_STATUS != dead",
    "human case evidence adequate",
    "KAEW_FINAL in calm/departed",
    "FLOOD_TRUTH_DISCLOSED=true after epilogue actual disclosure"
  ],
