  "dm": {
    "A": {
      "script": "เริ่มด้วยคำว่าจ้างและแจ้งผู้สูญหายสามคน",
      "secret": "ประเสริฐปิดบังบทบาทของตนในการปิดประตูน้ำ แต่ไม่ได้ลักพาตัวชาวบ้าน"
    },
    "B": {
      "script": "เปิดให้ทีมซักถามและเปรียบเทียบคำให้การ",
      "secret": "วิชัยเป็นเด็กที่แม่แก้วเคยช่วย และเป็นผู้ทำพิธีในปัจจุบัน"
    },
    "C": {
      "script": "ให้สำรวจร่องรอยบ้านดลและเสียงใต้พื้น",
      "secret": "เงาจมน้ำเป็นความทรงจำจากพิธี"
    },
    "D": {
      "script": "เปิดทางให้สืบเรื่องผนึกและเจรจากับแม่แก้ว",
      "secret": "คำตอบของแม่แก้วขึ้นกับความไว้ใจและความทรงจำ"
    },
    "E": {
      "script": "ให้ทีมตัดสินใจระหว่างช่วยผู้สูญหาย หยุดพิธี และจัดการวิญญาณ",
      "secret": "การจับวิชัยหรือทำให้แม่แก้วสลายยังไม่หยุดวงพิธี"
    }
  },
  "epilogues": {
    "confession": "ประเสริฐยอมรับต่อหน้าแม่แก้วว่าเขาช่วยปิดประตูน้ำในคืนนั้น",
    "bribe": "มีการรับข้อเสนอปกปิดเรื่องจากวิชัย เงินดังกล่าวไม่รวมในค่าจ้างบริษัท",
    "incomplete": "พิธีเดิมหยุดแล้ว แต่ทีมยังคลี่คลายคดีไม่ครบ",
    "teaser": "ฝ่ายตรวจสอบภายใน: พบสัญลักษณ์ตรงกับแฟ้มปิดผนึก CASE 017 (พ.ศ. 2552) กรุณาอย่าแนบภาพกำไลลงรายงานสาธารณะ"
  },
  "endingNarration": {
    "A": "แสงแรกส่องผ่านใบกล้วย แม่แก้วกล่าวขอบใจที่ฟัง ก่อนร่างค่อย ๆ จางหาย",
    "B": "ด้ายดำเส้นสุดท้ายถูกทำลาย ยายบุญมีวางดอกไม้ที่ศาล พลางบอกว่าสงบกับเป็นอิสระนั้นต่างกัน",
    "C": "รถตู้แล่นออกจากหนองตาลพร้อมผู้รอดชีวิต เสียงวิทยุถามว่าพื้นที่ปลอดภัยแล้วหรือยัง",
    "D": "ระฆังดังสามครั้ง เทียนในบ้านร้างดับพร้อมกัน เสียงร้องลอยออกไปถึงทุกบ้าน"
  }
}
